{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist/out-tsc",
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "sourceMap": true,
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@my-product-app/backend-company": ["libs/backend/company/src/index.ts"],
      "@my-product-app/backend-company-location": [
        "libs/backend/company-location/src/index.ts"
      ],
      "@my-product-app/backend-company-location-prisma": [
        "libs/backend/company-location-prisma/src/index.ts"
      ],
      "@my-product-app/backend-company-prisma": [
        "libs/backend/company-prisma/src/index.ts"
      ],
      "@my-product-app/backend-graphql-types": [
        "libs/backend/graphql-types/src/index.ts"
      ],
      "@my-product-app/backend-prisma/company-client": [
        "libs/backend/company-prisma/generated/company-client"
      ],
      "@my-product-app/backend-prisma/company-location-client": [
        "libs/backend/company-location-prisma/generated/company-location-client"
      ],
      "@my-product-app/backend-prisma/company-location-prisma": [
        "libs/backend/company-location-prisma/src/index.ts"
      ],
      "@my-product-app/backend-prisma/company-prisma": [
        "libs/backend/company-prisma/src/index.ts"
      ],
      "@my-product-app/backend-prisma/product-client": [
        "libs/backend/product-prisma/generated/product-client"
      ],
      "@my-product-app/backend-prisma/product-prisma": [
        "libs/backend/product-prisma/src/index.ts"
      ],
      "@my-product-app/backend-prisma/user-client": [
        "libs/backend/user-prisma/generated/user-client"
      ],
      "@my-product-app/backend-prisma/user-prisma": [
        "libs/backend/user-prisma/src/index.ts"
      ],
      "@my-product-app/backend-prisma/workorder-client": [
        "libs/backend/workorder-prisma/generated/workorder-client"
      ],
      "@my-product-app/backend-prisma/workorder-prisma": [
        "libs/backend/workorder-prisma/src/index.ts"
      ],
      "@my-product-app/backend-proto": ["libs/backend/proto/src/index.ts"],
      "@my-product-app/backend-proto/generated": [
        "libs/backend/proto/src/lib/generated/index.ts"
      ],
      "@my-product-app/backend-registration": [
        "libs/backend/registration/src/index.ts"
      ],
      "@my-product-app/backend-shared": ["libs/backend/shared/src/index.ts"],
      "@my-product-app/backend-shared-mappers": [
        "libs/backend/shared-mappers/src/index.ts"
      ],
      "@my-product-app/backend-shared-types": [
        "libs/backend/shared-types/src/index.ts"
      ],
      "@my-product-app/backend-shared/*": ["libs/backend/shared/src/lib/*"],
      "@my-product-app/company-grpc-client": [
        "libs/backend/company-grpc-client/src/index.ts"
      ],
      "@my-product-app/company-location-grpc-client": [
        "libs/backend/company-location-grpc-client/src/index.ts"
      ],
      "@my-product-app/frontend-core": ["libs/frontend/core/src/index.ts"],
      "@my-product-app/frontend-core/*": ["libs/frontend/core/src/lib/*"],
      "@my-product-app/frontend-data-access": [
        "libs/frontend/data-access/src/index.ts"
      ],
      "@my-product-app/frontend-data-access/*": [
        "libs/frontend/data-access/src/lib/*"
      ],
      "@my-product-app/frontend-graphql-types": [
        "libs/frontend/graphql-types/src/index.ts"
      ],
      "@my-product-app/frontend-graphql-types/*": [
        "libs/frontend/graphql-types/src/lib/*"
      ],
      "@my-product-app/frontend-shared": ["libs/frontend/shared/src/index.ts"],
      "@my-product-app/frontend-shared/*": ["libs/frontend/shared/src/lib/*"],
      "@my-product-app/frontend-ui": ["libs/frontend/ui/src/index.ts"],
      "@my-product-app/frontend-ui/*": ["libs/frontend/ui/src/lib/*"],
      "@my-product-app/logger": ["libs/backend/logger/src/index.ts"],
      "@my-product-app/product": ["libs/backend/product/src/index.ts"],
      "@my-product-app/user": ["libs/backend/user/src/index.ts"],
      "@my-product-app/user-grpc-client": [
        "libs/backend/user-grpc-client/src/index.ts"
      ],
      "@my-product-app/workorder": ["libs/backend/workorder/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "tmp"]
}
