{
  "name": "@my-product-app/source",
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.2",
  "license": "MIT",
  "scripts": {
    "start:all": "concurrently -n gateway,product,user -c blue,green,magenta \"nx serve api-gateway\" \"nx serve backend-product-service\" ",
    "build:all": "nx run-many --target=build --projects=api-gateway,backend-product-service, --parallel",
    "prisma:generate:all": "pnpm prisma generate --config libs/backend/product-prisma/prisma/prisma.config.ts && pnpm prisma generate --config libs/backend/user-prisma/prisma/prisma.config.ts && pnpm prisma generate --config libs/backend/company-prisma/prisma/prisma.config.ts && pnpm prisma generate --config libs/backend/company-location-prisma/prisma/prisma.config.ts && pnpm prisma generate --config libs/backend/workorder-prisma/prisma/prisma.config.ts",
    "prisma:generate": "pnpm prisma generate --schema=libs/backend/prisma/prisma/schema.prisma",
    "user-prisma:generate": "pnpm prisma generate --schema=libs/backend/user-prisma/prisma/schema.prisma",
    "prisma:prepare": "nx run-many --target=generate --projects=prisma && nx build prisma && nx build user",
    "studio": "pnpm prisma studio --schema=libs/backend/prisma/prisma/schema.prisma",
    "generate:schema": "graphql-codegen --config codegen.yml --schema http://localhost:3002/graphql --output libs/backend/graphql-types/src/lib/generated/schema.graphql",
    "generate": "graphql-codegen --config codegen.yml",
    "proto:generate": "pnpm exec protoc --plugin=protoc-gen-ts_proto=%CD%\\node_modules\\.bin\\protoc-gen-ts_proto.cmd --ts_proto_out=libs/backend/proto/src/lib/generated --ts_proto_opt=nestJs=true,outputServices=grpc-js,grpcClients=grpc-js,addGrpcMetadata=true,outputDirFlatten=true -I=libs/backend/proto/src/lib ./libs/backend/proto/src/lib/*.proto",
    "clean": "rimraf dist",
    "build": "nx build",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "graphql:generate": "nx run user:graphql-schema",
    "build:libs": "nx run-many --target=build --projects=logger,prisma,product,backend-shared,user,frontend-shared,frontend-data-access,ui --parallel",
    "serve:backend": "concurrently \"nx serve api-gateway\" \"nx serve backend-product-service\"  \"nx serve workorder-service\"",
    "serve:frontend": "nx serve frontend",
    "dev": "concurrently \"npm run serve:backend\" \"npm run serve:frontend\"",
    "watch:libs": "concurrently \"nx build logger --watch\" \"nx build prisma --watch\" \"nx build backend-shared --watch\" \"nx build user --watch\" \"nx build product --watch\"",
    "watch:frontend-Ui": "concurrently  \"nx build ui --watch\"",
    "watch:frontend-shared": "concurrently  \"nx build frontend-shared --watch\"",
    "watch:frontend-data-access": "concurrently  \"nx build frontend-data-access --watch\"",
    "build:frontend": "nx run-many --target=build --all --tags=type:frontend",
    "build:backend": "nx run-many --target=build --all --tags=type:backend",
    "build:apps": "nx run-many --target=build --all --exclude-e2e"
  },
  "private": true,
