{
  "name": "workorder-service",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/workorder-service/src",
  "projectType": "application",
  "tags": ["type:service", "scope:backend", "area:workorder"],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{workspaceRoot}/dist/apps/backend/workorder-service"],
      "options": {
        "webpackConfig": "apps/backend/workorder-service/webpack.config.js",
        "outputPath": "dist/apps/backend/workorder-service",
        "watch": false
      },
      "configurations": {
        "development": {
          "webpackConfig": "apps/backend/workorder-service/webpack.config.js",
          "outputPath": "dist/apps/backend/workorder-service"
        },
        "production": {
          "webpackConfig": "apps/backend/workorder-service/webpack.config.js",
          "outputPath": "dist/apps/backend/workorder-service"
        }
      }
    },

    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "parallel": true,
        "commands": [
          {
            "command": "nx build workorder-service --configuration=development",
            "forwardAllArgs": false
          },
          {
            "command": "wait-on dist/apps/backend/workorder-service/main.js && node dist/apps/backend/workorder-service/main.js",
            "forwardAllArgs": false
          }
        ]
      }
    },

    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/backend/workorder-service/jest.config.ts",
        "passWithNoTests": true
      }
    },

    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/backend/workorder-service/package.json",
        "{workspaceRoot}/dist/apps/backend/workorder-service/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },

    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/backend/workorder-service/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },

    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    }
  }
}
