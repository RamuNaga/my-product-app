{
  "name": "api-gateway",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/api-gateway/src",
  "projectType": "application",
  "tags": [
    "type:gateway",
    "scope:backend",
    "area:gateway"
  ],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": [
        "{workspaceRoot}/dist/apps/backend/api-gateway"
      ],
      "options": {
        "webpackConfig": "apps/backend/api-gateway/webpack.config.js",
        "outputPath": "dist/apps/backend/api-gateway",
      },

      "configurations": {
        "development": {
          "watch": true
        },
        "production": {
          "watch": false
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "parallel": true,
        "commands": [
          {
            "command": "nx build api-gateway --configuration=development",
            "forwardAllArgs": false
          },
          {
            "command": "wait-on dist/apps/backend/api-gateway/main.js && node dist/apps/backend/api-gateway/main.js",
            "forwardAllArgs": false
          }
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/backend/api-gateway/jest.config.ts"
      }
    }
  }
}