{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/apps/backend/user-grpc",
    "module": "commonjs",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021"
  },

  "include": ["src/**/*.ts"],
  "exclude": [
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "**/generated/**"
  ]
}
