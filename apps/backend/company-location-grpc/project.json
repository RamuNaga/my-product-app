{
  "name": "company-location-grpc",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/company-location-grpc/src",
  "projectType": "application",
  "tags": ["type:grpc", "domain:company-location", "scope:backend"],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{workspaceRoot}/dist/apps/backend/company-location-grpc"],
      "options": {
        "webpackConfig": "apps/backend/company-location-grpc/webpack.config.js",
        "outputPath": "dist/apps/backend/company-location-grpc",
        "watch": false
      },
      "configurations": {
        "development": {
          "webpackConfig": "apps/backend/company-location-grpc/webpack.config.js",
          "outputPath": "dist/apps/backend/company-location-grpc"
        },
        "production": {
          "webpackConfig": "apps/backend/company-location-grpc/webpack.config.js",
          "outputPath": "dist/apps/backend/company-location-grpc"
        }
      }
    },

    "copy-protos": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx copyfiles -u 5 \"libs/backend/proto/src/lib/company-location.proto\" \"dist/apps/backend/company-location-grpc/\""
      }
    },

    "build-with-protos": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run company-location-grpc:build && nx run company-location-grpc:copy-protos"
      }
    },

    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build-with-protos"],
      "options": {
        "buildTarget": "company-location-grpc:build-with-protos",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "company-location-grpc:build-with-protos"
        },
        "production": {
          "buildTarget": "company-location-grpc:build-with-protos"
        }
      }
    },

    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/backend/company-location-grpc/jest.config.ts",
        "passWithNoTests": true
      }
    },

    "prune-lockfile": {
      "dependsOn": ["build-with-protos"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/backend/company-location-grpc/package.json",
        "{workspaceRoot}/dist/apps/backend/company-location-grpc/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build-with-protos"
      }
    },

    "copy-workspace-modules": {
      "dependsOn": ["build-with-protos"],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/backend/company-location-grpc/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build-with-protos"
      }
    },

    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    }
  }
}
