{
  "name": "bff",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/bff/src",
  "projectType": "application",
  "tags": ["type:bff scope:backend"],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{workspaceRoot}/dist/apps/backend/bff"],
      "options": {
        "webpackConfig": "apps/backend/bff/webpack.config.js",
        "outputPath": "dist/apps/backend/bff",
        "watch": false
      }
    },

    "copy-protos": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx copyfiles -u 5 \"libs/backend/proto/src/lib/*.proto\" \"dist/apps/backend/proto/\""
      }
    },

    "build-with-protos": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run bff:build && nx run bff:copy-protos"
      }
    },

    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      // "dependsOn": [
      //   "user-grpc:build-with-protos",
      //   "company-grpc:build-with-protos",
      //   "company-location-grpc:build-with-protos",
      //   "bff:build-with-protos"
      // ],
      "options": {
        "buildTarget": "bff:build-with-protos",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "bff:build-with-protos"
        },
        "production": {
          "buildTarget": "bff:build-with-protos"
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/backend/bff/package.json",
        "{workspaceRoot}/dist/apps/backend/bff/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/backend/bff/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },

    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/backend/bff/jest.config.ts",
        "passWithNoTests": true
      }
    }
  }
}
