{
  "name": "user-prisma",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/backend/user-prisma/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:backend", "area:user-prisma"],

  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/backend/user-prisma",
        "main": "libs/backend/user-prisma/src/index.ts",
        "tsConfig": "libs/backend/user-prisma/tsconfig.lib.json",
        "assets": ["libs/backend/user-prisma/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/backend/user-prisma/jest.config.ts"
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm prisma generate --schema=libs/backend/user-prisma/prisma/schema.prisma"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/backend/user-prisma/**/*.ts",
          "libs/backend/user-prisma/**/*.tsx"
        ]
      }
    }
  }
}
