{
  "name": "shared-mappers",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/backend/shared-mappers/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/backend/shared-mappers",
        "tsConfig": "libs/backend/shared-mappers/tsconfig.lib.json",
        "packageJson": "libs/backend/shared-mappers/package.json",
        "main": "libs/backend/shared-mappers/src/index.ts",
        "assets": ["libs/backend/shared-mappers/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/backend/shared-mappers/jest.config.ts"
      }
    }
  }
}
