{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,

    "types": ["node"],
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node"
  },

  "include": ["src/**/*.ts"],
  "exclude": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.test.ts"],
  "references": [{ "path": "../user-prisma" }, { "path": "../shared" }]
}
