{
  "name": "graphql-types",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/backend/graphql-types/src",
  "projectType": "library",
  "tags": ["type:graphql-types"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/backend/graphql-types",
        "tsConfig": "libs/backend/graphql-types/tsconfig.lib.json",
        "packageJson": "libs/backend/graphql-types/package.json",
        "main": "libs/backend/graphql-types/src/index.ts",
        "assets": ["libs/backend/graphql-types/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/backend/graphql-types/jest.config.ts"
      }
    }
  }
}
