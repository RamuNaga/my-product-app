generator client {
  provider = "prisma-client-js"
  output   = "../generated/product-client"
}

datasource db {
  provider = "postgresql"
}

enum UnitOfMeasure {
  G
  KG
  ML
  L
  EACH
}

enum ItemKind {
  RAW_MATERIAL
  PURCHASED_PREPARED
  MANUFACTURED_COMPONENT
  SAUCE
  GARNISH
  PACKAGING
  OTHER
}

enum SupplyType {
  PURCHASED
  MANUFACTURED
  BOTH
}

enum ProcessType {
  NONE
  OVEN
  STEAM
  SAUCE_PREPARATION
  MIXING
  OTHER
}

enum RecipeStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum RecipePurpose {
  FINISHED_FOOD
  INTERMEDIATE
}

// Canonical stockable master: ingredients, sauces, cooked intermediates, packaging.
// I/M prefixes are assigned by a confirmed business coding policy, NOT inferred from SupplyType.
model Item {
  id                    Int                    @id @default(autoincrement())
  code                  String                 @unique
  name                  String
  description           String?
  kind                  ItemKind
  supplyType            SupplyType             @default(PURCHASED)
  processType           ProcessType            @default(NONE)
  baseUnit              UnitOfMeasure
  allergenDeclaration   String?
  origin                String?
  manufacturer          String?
  defaultSupplierId     Int? // external Supplier reference; optional
  packSizeDescription   String?
  netContentDescription String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  componentLines        RecipeLine[]
  outputRevisions       RecipeRevision[]       @relation("ManufacturedOutput")
  packagingLines        ProductPackagingLine[]

  @@index([kind, isActive])
  @@index([supplyType])
}

model ItemCodeSequence {
  prefix     String   @id // e.g. I or M, subject to factory code rule
  nextNumber Int
  updatedAt  DateTime @updatedAt
}

model Product {
  id                Int                       @id @default(autoincrement())
  productCode       String                    @unique
  name              String
  description       String
  image             String?
  productWeight     String // legacy: preserve during migration
  netWeightG        Decimal?                  @db.Decimal(18, 3)
  price             Float // legacy: preserve; future money fields should use Decimal
  companyId         Int?
  isActive          Boolean                   @default(true)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  recipeAssignments ProductRecipeAssignment[]
  packagingLines    ProductPackagingLine[]
  nutritionalInfo   NutritionalInfo?

  @@index([companyId])
}

// A formula is independent of pack size and finished-product ID.
model Recipe {
  id          Int              @id @default(autoincrement())
  code        String           @unique
  name        String
  description String?
  purpose     RecipePurpose
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  revisions   RecipeRevision[]
}

model RecipeRevision {
  id                 Int                       @id @default(autoincrement())
  recipeId           Int
  revision           Int
  status             RecipeStatus              @default(DRAFT)
  referenceQuantity  Decimal                   @db.Decimal(18, 6) // e.g. 1000 G of finished food, 100 KG of sauce
  referenceUnit      UnitOfMeasure
  // Required for INTERMEDIATE, NULL for FINISHED_FOOD; enforce in service + SQL.
  outputItemId       Int?
  processType        ProcessType               @default(NONE)
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  approvedAt         DateTime?
  approvedById       Int? // external User ID
  notes              String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  recipe             Recipe                    @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  outputItem         Item?                     @relation("ManufacturedOutput", fields: [outputItemId], references: [id], onDelete: Restrict)
  lines              RecipeLine[]
  productAssignments ProductRecipeAssignment[]

  @@unique([recipeId, revision])
  @@index([outputItemId, status])
  @@index([status, effectiveFrom])
}

// All food components (including multiple sauces) are just recipe lines.
// An intermediate Item has its own separate manufacturing recipe revision.
model RecipeLine {
  id                 Int            @id @default(autoincrement())
  recipeRevisionId   Int
  lineNumber         Int
  componentItemId    Int
  quantity           Decimal        @db.Decimal(18, 6)
  unit               UnitOfMeasure
  processLossPercent Decimal?       @db.Decimal(7, 4) // optional planned loss; no implicit double-counting
  notes              String?
  recipeRevision     RecipeRevision @relation(fields: [recipeRevisionId], references: [id], onDelete: Restrict)
  componentItem      Item           @relation(fields: [componentItemId], references: [id], onDelete: Restrict)

  @@unique([recipeRevisionId, lineNumber])
  @@index([componentItemId])
}

// Multiple assignments over time; prevent overlapping active effective windows in application/SQL.
model ProductRecipeAssignment {
  id               Int            @id @default(autoincrement())
  productId        Int
  recipeRevisionId Int
  portionQuantity  Decimal        @db.Decimal(18, 6) // food quantity per ONE finished pack
  portionUnit      UnitOfMeasure  @default(G)
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  createdAt        DateTime       @default(now())
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  recipeRevision   RecipeRevision @relation(fields: [recipeRevisionId], references: [id], onDelete: Restrict)

  @@unique([productId, recipeRevisionId, effectiveFrom])
  @@index([productId, effectiveFrom])
}

// Packaging is per finished pack, NOT proportional to food mass.
model ProductPackagingLine {
  id            Int           @id @default(autoincrement())
  productId     Int
  itemId        Int
  quantity      Decimal       @db.Decimal(18, 6)
  unit          UnitOfMeasure @default(EACH)
  effectiveFrom DateTime      @default(now())
  effectiveTo   DateTime?
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([productId, effectiveFrom])
}

// Preserve these existing tables until their use and data are audited.
model Tray {
  id         Int      @id @default(autoincrement())
  trayName   String
  dimensions String?
  weight     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Garnish {
  id        Int      @id @default(autoincrement())
  name      String
  weight    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Unit {
  id        Int      @id @default(autoincrement())
  name      String
  noOfUnits Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NutritionalInfo {
  id        Int     @id @default(autoincrement())
  productId Int     @unique
  calories  Float
  fat       Float
  protein   Float
  sugar     Float
  fibre     Float
  salt      Float
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}
