{
  "name": "ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frontend/ui/src",
  "prefix": "lib",
  "projectType": "library",
  "schematics": {
    "@nx/angular:component": {
      "prefix": "lib"
    }
  },
  "tags": ["type:ui", "scope:frontend", "platform:angular"],
  "implicitDependencies": [
    "frontend-core",
    "frontend-graphql-types",
    "frontend-data-access",
    "frontend-shared"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/frontend/ui",
        "main": "libs/frontend/ui/src/index.ts",
        "tsConfig": "libs/frontend/ui/tsconfig.lib.json",
        "assets": ["libs/frontend/ui/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/frontend/ui/jest.config.ts",
        "tsConfig": "libs/frontend/ui/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
