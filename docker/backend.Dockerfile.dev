FROM node:22-alpine AS base

WORKDIR /workspace

RUN apk add --no-cache bash curl git

RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

# Copy the full Nx/pnpm workspace.
# .dockerignore should exclude node_modules, dist, Nx cache, etc.
COPY . .

# Install both prod + dev dependencies because Nx build tooling is needed here.
RUN pnpm install --frozen-lockfile --prod=false

RUN chmod +x wait-for-it.sh
RUN chmod +x dev-entrypoint.sh

ARG SERVICE
ARG SERVICE_DIR

RUN pnpm nx run ${SERVICE}:build


# ---------------------------------------------------------
# Runtime
# ---------------------------------------------------------
FROM node:22-alpine AS runtime

WORKDIR /workspace

RUN apk add --no-cache bash

RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

ARG SERVICE
ARG SERVICE_DIR

# Reuse the fully resolved pnpm dependency tree from the build stage.
COPY --from=base /workspace/node_modules ./node_modules

# pnpm link: dependencies point to these generated Prisma client directories.
# They must exist in the runtime image.
COPY --from=base /workspace/libs/backend/user-prisma/generated \
  ./libs/backend/user-prisma/generated

COPY --from=base /workspace/libs/backend/product-prisma/generated \
  ./libs/backend/product-prisma/generated

COPY --from=base /workspace/libs/backend/company-prisma/generated \
  ./libs/backend/company-prisma/generated

COPY --from=base /workspace/libs/backend/company-location-prisma/generated \
  ./libs/backend/company-location-prisma/generated

COPY --from=base /workspace/libs/backend/workorder-prisma/generated \
  ./libs/backend/workorder-prisma/generated

# Built Nx application.
COPY --from=base /workspace/dist/apps/backend/${SERVICE_DIR} ./dist

# Runtime helper scripts.
COPY --from=base /workspace/wait-for-it.sh ./wait-for-it.sh
COPY --from=base /workspace/dev-entrypoint.sh ./dev-entrypoint.sh

RUN chmod +x wait-for-it.sh dev-entrypoint.sh

ENV NODE_ENV=development

EXPOSE 3000

CMD ["sh", "./dev-entrypoint.sh"]


# ---------------------------------------------------------
# Migration
# ---------------------------------------------------------
FROM node:22-alpine AS migrate

WORKDIR /workspace

RUN apk add --no-cache bash curl git

RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

# Migration needs the workspace because Prisma packages/configs live there.
COPY . .

RUN pnpm install --frozen-lockfile --prod=false

COPY wait-for-it.sh ./wait-for-it.sh
COPY scripts/migrate.sh ./scripts/migrate.sh

RUN chmod +x wait-for-it.sh scripts/migrate.sh

CMD ["bash", "scripts/migrate.sh"]