FROM node:22-alpine AS base

WORKDIR /workspace

RUN apk add --no-cache bash curl git

RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

# Copy the whole workspace first.
# .dockerignore now keeps caches/node_modules out of the context.
COPY . .

# pnpm can now see workspace package.json files and link: dependencies.
RUN pnpm install --frozen-lockfile --prod=false

RUN node -e "console.log('Prisma client:', require.resolve('user-prisma-client'))"

RUN chmod +x wait-for-it.sh
RUN chmod +x dev-entrypoint.sh

ARG SERVICE
ARG SERVICE_DIR

RUN pnpm nx run ${SERVICE}:build


FROM node:22-alpine AS runtime

WORKDIR /workspace

RUN apk add --no-cache bash

RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

RUN pnpm install --frozen-lockfile --prod

ARG SERVICE
ARG SERVICE_DIR

COPY --from=base /workspace/dist/apps/backend/${SERVICE_DIR} ./dist

COPY --from=base /workspace/wait-for-it.sh ./wait-for-it.sh
RUN chmod +x wait-for-it.sh

ENV NODE_ENV=development

EXPOSE 3000

COPY --from=base /workspace/dev-entrypoint.sh ./dev-entrypoint.sh

CMD ["sh", "./dev-entrypoint.sh"]


FROM node:22-alpine AS migrate

WORKDIR /workspace

RUN apk add --no-cache bash curl git

RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

RUN pnpm install --frozen-lockfile --prod=false

COPY libs/backend/company-prisma/prisma ./prisma/company
COPY libs/backend/company-location-prisma/prisma ./prisma/company-location
COPY libs/backend/product-prisma/prisma ./prisma/product
COPY libs/backend/user-prisma/prisma ./prisma/user
COPY libs/backend/workorder-prisma/prisma ./prisma/workorder

COPY wait-for-it.sh ./wait-for-it.sh
COPY scripts/migrate.sh ./scripts/migrate.sh

RUN chmod +x wait-for-it.sh scripts/migrate.sh

CMD ["bash", "scripts/migrate.sh"]