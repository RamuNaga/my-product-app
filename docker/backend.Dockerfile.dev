# ---------------------------------------------------------
# Base / Dependencies
# ---------------------------------------------------------
FROM node:22-alpine AS base

WORKDIR /workspace

RUN apk add --no-cache bash curl git

RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

# Copy the full Nx/pnpm workspace.
# .dockerignore should exclude node_modules, dist, Nx cache, etc.
COPY . .

# Nx build and Prisma migration tooling are required.
RUN pnpm install --frozen-lockfile --prod=false

RUN chmod +x wait-for-it.sh \
    dev-entrypoint.sh \
    scripts/migrate.sh


# ---------------------------------------------------------
# Application Build
# ---------------------------------------------------------
FROM base AS build

ARG SERVICE
ARG SERVICE_DIR

RUN pnpm nx run ${SERVICE}:build


# ---------------------------------------------------------
# Runtime
# ---------------------------------------------------------
FROM node:22-alpine AS runtime

WORKDIR /workspace

RUN apk add --no-cache bash

RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

ARG SERVICE
ARG SERVICE_DIR

# Reuse dependencies from application build.
COPY --from=build /workspace/node_modules ./node_modules

# Generated Prisma clients required by pnpm-linked packages.
COPY --from=build /workspace/libs/backend/user-prisma/generated \
  ./libs/backend/user-prisma/generated

COPY --from=build /workspace/libs/backend/product-prisma/generated \
  ./libs/backend/product-prisma/generated

COPY --from=build /workspace/libs/backend/company-prisma/generated \
  ./libs/backend/company-prisma/generated

COPY --from=build /workspace/libs/backend/company-location-prisma/generated \
  ./libs/backend/company-location-prisma/generated

COPY --from=build /workspace/libs/backend/workorder-prisma/generated \
  ./libs/backend/workorder-prisma/generated

# Built Nx application.
COPY --from=build /workspace/dist/apps/backend/${SERVICE_DIR} ./dist

# Runtime helper scripts.
COPY --from=build /workspace/wait-for-it.sh ./wait-for-it.sh
COPY --from=build /workspace/dev-entrypoint.sh ./dev-entrypoint.sh

RUN chmod +x wait-for-it.sh dev-entrypoint.sh

ENV NODE_ENV=development

EXPOSE 3000

CMD ["sh", "./dev-entrypoint.sh"]


# ---------------------------------------------------------
# Migration
# ---------------------------------------------------------
FROM base AS migrate

WORKDIR /workspace

# Stable migration layout expected by scripts/migrate.sh.
RUN mkdir -p \
    prisma/user \
    prisma/company \
    prisma/company-location \
    prisma/product \
    prisma/workorder

COPY libs/backend/user-prisma/prisma/ \
    ./prisma/user/

COPY libs/backend/company-prisma/prisma/ \
    ./prisma/company/

COPY libs/backend/company-location-prisma/prisma/ \
    ./prisma/company-location/

COPY libs/backend/product-prisma/prisma/ \
    ./prisma/product/

COPY libs/backend/workorder-prisma/prisma/ \
    ./prisma/workorder/

CMD ["bash", "scripts/migrate.sh"]