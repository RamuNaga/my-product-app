# ---------------------------------------------------------
# Base Dev Image
# ---------------------------------------------------------
FROM node:20-alpine AS base
WORKDIR /workspace

# Install bash, curl, git
RUN apk add --no-cache bash curl git

# Enable corepack & pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy package files for caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Install dev dependencies
RUN pnpm install --frozen-lockfile --prod=false

# Copy all source files
COPY . .

# Make wait-for-it.sh executable
RUN chmod +x wait-for-it.sh

# Make dev-entrypoint.sh executable if you plan to use it
RUN chmod +x dev-entrypoint.sh

# Build the given service including protos
ARG SERVICE
RUN pnpm nx run ${SERVICE}:build-with-protos

# ---------------------------------------------------------
# Runtime Stage
# ---------------------------------------------------------
FROM node:20-alpine AS runtime
WORKDIR /workspace

RUN apk add --no-cache bash

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --prod

ARG SERVICE
COPY --from=base /workspace/dist/apps/backend/${SERVICE} ./dist

# Copy wait-for-it.sh so runtime can wait for DB if needed
COPY --from=base /workspace/wait-for-it.sh ./wait-for-it.sh
RUN chmod +x wait-for-it.sh

ENV NODE_ENV=development
EXPOSE 3000

# Use dev-entrypoint.sh as default entrypoint
COPY --from=base /workspace/dev-entrypoint.sh ./dev-entrypoint.sh
CMD ["sh", "./dev-entrypoint.sh"]

# ---------------------------------------------------------
# Migrate Stage
# ---------------------------------------------------------
FROM node:20-alpine AS migrate
WORKDIR /workspace

RUN apk add --no-cache bash curl git
RUN corepack enable && corepack prepare pnpm@latest --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --prod

COPY libs/backend/company-prisma/prisma ./prisma/company
COPY libs/backend/company-location-prisma/prisma ./prisma/company-location
COPY libs/backend/product-prisma/prisma ./prisma/product
COPY libs/backend/user-prisma/prisma ./prisma/user
COPY libs/backend/workorder-prisma/prisma ./prisma/workorder

COPY wait-for-it.sh ./wait-for-it.sh
COPY scripts/migrate.sh ./scripts/migrate.sh
RUN chmod +x wait-for-it.sh scripts/migrate.sh

CMD ["bash","scripts/migrate.sh"]